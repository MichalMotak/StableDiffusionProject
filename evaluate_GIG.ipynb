    "def evaluate_first_img_sim(controlnet_path, test_dataset, return_metrics = True, stop_at = 10000, process_mask=\"\", save_videos = False, flow_type= None, \n",
    "                                           mod = False, parameters={}):\n",
    "\n",
    "    device = \"cuda:0\"\n",
    "    st = 20\n",
    "\n",
    "\n",
    "    vae = AutoencoderKLTemporalDecoder.from_pretrained(\n",
    "        \"ckpts/stable-video-diffusion-img2vid-xt-1-1\", subfolder=\"vae\", variant=\"fp16\"\n",
    "    ).to(device)\n",
    "\n",
    "    unet = UNetSpatioTemporalConditionControlNetModel.from_pretrained(\n",
    "        \"ckpts/stable-video-diffusion-img2vid-xt-1-1\", \n",
    "        subfolder=\"unet\", \n",
    "        low_cpu_mem_usage=True, \n",
    "        variant=\"fp16\"\n",
    "    ).to(device)\n",
    "\n",
    "    # # --- PROBE START ---\n",
    "    # # Pick a layer that definitely changes during fine-tuning\n",
    "    # probe_layer = \"conv_in.weight\"\n",
    "    # val_before = unet.state_dict()[probe_layer].sum().item()\n",
    "    # # print(f\"Weight Sum BEFORE loading: {val_before:.6f}\")\n",
    "\n",
    "    # # 2. LOAD STAGE 1 WEIGHTS (The \"LoRA\" / Full Fine-tuned UNet)\n",
    "    # # We do this BEFORE creating the ControlNet so the ControlNet inherits the right features.\n",
    "    # lora_path = \"/home/MichalMo/projects/animate-anything/output/svd/train_2026-03-19T16-18-33/checkpoint-20000/unet/diffusion_pytorch_model.safetensors\"\n",
    "    # full_unet_sd = load_file(lora_path, device=\"cpu\")\n",
    "\n",
    "    # # Apply the prefix logic we discussed\n",
    "    # current_model_keys = list(unet.state_dict().keys())\n",
    "    # has_unet_prefix = any(k.startswith(\"unet.\") for k in current_model_keys)\n",
    "    # cleaned_sd = {}\n",
    "    # for k, v in full_unet_sd.items():\n",
    "    #     new_key = \"unet.\" + k if (has_unet_prefix and not k.startswith(\"unet.\")) else (k.replace(\"unet.\", \"\") if (not has_unet_prefix and k.startswith(\"unet.\")) else k)\n",
    "    #     cleaned_sd[new_key] = v\n",
    "\n",
    "\n",
    "\n",
    "    # msg = unet.load_state_dict(cleaned_sd, strict=False)\n",
    "    # # Check how many parameters actually changed\n",
    "    # matched_keys = [k for k in cleaned_sd.keys() if k in unet.state_dict().keys()]\n",
    "    # print(f\"Matched {len(matched_keys)} out of {len(cleaned_sd)} keys from the file.\")\n",
    "\n",
    "    # if len(matched_keys) == 0:\n",
    "    #     print(\"CRITICAL ERROR: No weights were actually loaded. Check naming convention!\")\n",
    "\n",
    "\n",
    "    # print(f\"Successfully loaded Stage 1 (Cataract) weights into UNet: {msg}\")\n",
    "\n",
    "\n",
    "    # # --- PROBE END ---\n",
    "    # val_after = unet.state_dict()[probe_layer].sum().item()\n",
    "    # print(f\"Weight Sum AFTER loading:  {val_after:.6f}\")\n",
    "\n",
    "    # if abs(val_before - val_after) < 1e-7:\n",
    "    #     print(\"❌ WARNING: Weights did not change! The load failed silently.\")\n",
    "    # else:\n",
    "    #     print(f\"✅ SUCCESS: Weights changed by {abs(val_before - val_after):.6f}\")\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "    # 3. INITIALIZE CONTROLNET FROM THE UPDATED UNET\n",
    "    # This copies the structure (and internal weights) of your fine-tuned UNet\n",
    "    controlnet = DualFlowControlNet_traj.from_unet(unet)\n",
    "\n",
    "    # 4. LOAD STAGE 2 WEIGHTS (The actual ControlNet training)\n",
    "    state_dict = load_file(controlnet_path, device=\"cpu\")\n",
    "    controlnet.load_state_dict(state_dict)\n",
    "    controlnet.to(device)\n",
    "\n",
    "    # Now set your custom weights\n",
    "    controlnet.mask_weight = parameters[\"mask_weight\"]\n",
    "    print(f\"ControlNet mask_weight set to: {controlnet.mask_weight}\")\n",
    "\n",
    "    # 5. Setup remaining Pipeline\n",
    "    image_encoder = CLIPVisionModelWithProjection.from_pretrained(\n",
    "        \"ckpts/stable-video-diffusion-img2vid-xt-1-1\", subfolder=\"image_encoder\", variant=\"fp16\"\n",
    "    )\n",
    "\n",
    "    pipeline = DualFlowControlNetPipeline.from_pretrained(\n",
    "        \"ckpts/stable-video-diffusion-img2vid-xt-1-1\",\n",
    "        unet=unet,\n",
    "        controlnet=controlnet,\n",
    "        image_encoder=image_encoder,\n",
    "        vae=vae,\n",
    "        torch_dtype=torch.float16,\n",
    "    )\n",
    "    pipeline = pipeline.to(device)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "    # Define Unimatch for optical flow prediction\n",
    "    unimatch = UniMatch(feature_channels=128,\n",
    "        num_scales=2,\n",
    "        upsample_factor=4,\n",
    "        num_head=1,\n",
    "        ffn_dim_expansion=4,\n",
    "        num_transformer_layers=6,\n",
    "        reg_refine=True,\n",
    "        task='flow').to('cuda')\n",
    "\n",
    "    # checkpoint = torch.load('./Training/train_utils/unimatch/pretrained/gmflow-scale2-regrefine6-mixdata-train320x576-4e7b215d.pth')\n",
    "    checkpoint = torch.load('train_utils/unimatch/pretrained/gmflow-scale2-regrefine6-mixdata-train320x576-4e7b215d.pth')\n",
    "\n",
    "    unimatch.load_state_dict(checkpoint['model'])\n",
    "\n",
    "    unimatch = unimatch.to(device).eval()\n",
    "    unimatch.requires_grad_(False)\n",
    "\n",
    "    # Depth Anything Model\n",
    "    model_configs = {\n",
    "        'vits': {'encoder': 'vits', 'features': 64, 'out_channels': [48, 96, 192, 384]},\n",
    "        'vitb': {'encoder': 'vitb', 'features': 128, 'out_channels': [96, 192, 384, 768]},\n",
    "        'vitl': {'encoder': 'vitl', 'features': 256, 'out_channels': [256, 512, 1024, 1024]},\n",
    "        'vitg': {'encoder': 'vitg', 'features': 384, 'out_channels': [1536, 1536, 1536, 1536]}\n",
    "    }\n",
    "    depth_anything = DepthAnythingV2(**model_configs['vitb'])\n",
    "    depth_anything.load_state_dict(torch.load(f'train_utils/dav2/ckpts/depth_anything_v2_vitb.pth', map_location='cpu'))\n",
    "    depth_anything = depth_anything.to(device).eval()\n",
    "    depth_anything.requires_grad_(False)\n",
    "\n",
    "\n",
    "    cmp = CMP_demo(\n",
    "        'MOFA-Video-Traj/models/cmp/experiments/semiauto_annot/resnet50_vip+mpii_liteflow/config.yaml',\n",
    "        42000\n",
    "    ).to(device)\n",
    "    cmp.requires_grad_(False)\n",
    "\n",
    "    # test_dataset = DatasetRetinaVideo(image_size=256, from_file='/home/MichalMo/projects/SurGrID/datasets/Cataract-1K/data_test.pkl')\n",
    "\n",
    "\n",
    "    test_loader = DataLoader(test_dataset,\n",
    "                            batch_size=1,\n",
    "                            shuffle=False,\n",
    "                            num_workers=4)\n",
    "\n",
    "\n",
    "    print(\"Starting evaluation...\")\n",
    "\n",
    "    weight_dtype = torch.float16\n",
    "\n",
    "    metric_results =[]\n",
    "\n",
    "    num_frames = 21\n",
    "\n",
    "\n",
    "    out_nps_full = []\n",
    "    gt_nps_full = []\n",
    "    gt_masks_nps_full = []\n",
    "\n",
    "\n",
    "    #####################\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "    for i, val_batch in enumerate(tqdm(test_loader)):\n",
    "\n",
    "\n",
    "        if i == stop_at:\n",
    "            break\n",
    "\n",
    "        indexes = list(range(st, st+21))\n",
    "        print(indexes)\n",
    "\n",
    "        val_batch = test_dataset.get_batch(indexes=indexes)\n",
    "        # video_name = f\"video_{test_dataset.record}_{indexes[0]}_{indexes[1] + test_dataset.num_frames}\"\n",
    "            \n",
    "        # print(\"VIDEO NAME \", video_name)\n",
    "        # val_pixel_values = val_batch['image'].to(weight_dtype).to(device)  # [b, t, c, W, H]\n",
    "        val_pixel_values = torch.Tensor(val_batch[0]).unsqueeze(0).to(weight_dtype).to(device)  # [b, t, c, W, H]\n",
    "        print(\"val_pixel_values \", val_pixel_values.shape)\n",
    "\n",
    "        \n",
    "        val_depths, depth_img = get_dav2_flows(depth_anything, val_pixel_values)\n",
    "        val_depths = val_depths.to(torch.float16).to(device)\n",
    "\n",
    "\n",
    "        # val_masks = get_sam_flows(predictor, val_pixel_values)\n",
    "\n",
    "\n",
    "        # Inside your training loop\n",
    "        # val_masks_org = val_batch['mask']  # Shape: [B, 14, 256, 256]\n",
    "        val_masks_org = torch.Tensor(val_batch[2]).unsqueeze(0)  # Shape: [B, 14, 256, 256]\n",
    "\n",
    "        print(\"val_masks_org \", val_masks_org.shape)\n",
    "\n",
    "        # if process_mask == \"cataract_to_przemek\":\n",
    "        #     val_masks_org = cataract_to_przemek_fun(val_masks_org.numpy())\n",
    "        #     val_masks_org = torch.Tensor(val_masks_org)\n",
    "\n",
    "\n",
    "        val_masks_org = przemek_to_cataract_fun(val_masks_org.numpy())\n",
    "        # val_masks_org = val_masks_org.numpy()\n",
    "\n",
    "        val_masks_org = torch.Tensor(val_masks_org)\n",
    "\n",
    "        # val_flows = get_optical_flows(unimatch, val_pixel_values) \n",
    "        # val_flows = val_flows.to(torch.float16).to(device)\n",
    "        print(\"val_masks_org \", val_masks_org.shape)\n",
    "\n",
    "\n",
    "        val_controlnet_image, val_sparse_optical_flow, \\\n",
    "            val_mask, unimatch_flow, val_pixel_values_384, \\\n",
    "                val_sparse_optical_flow_384, val_mask_384 = sample_inputs(unimatch, val_pixel_values)\n",
    "        \n",
    "\n",
    "        fb, fl, fc, fh, fw = val_sparse_optical_flow.shape\n",
    "\n",
    "        val_controlnet_flow, _ = get_cmp_flow(\n",
    "            cmp, \n",
    "            val_pixel_values_384[:, 0:1, :, :, :].repeat(1, fl, 1, 1, 1), \n",
    "            val_sparse_optical_flow_384, \n",
    "            val_mask_384\n",
    "        )\n",
    "\n",
    "        val_controlnet_depth, depth_img = get_dav2_flows(depth_anything,val_pixel_values)\n",
    "        if fh != 384 or fw != 384:\n",
    "            scales = [fh / 384, fw / 384]\n",
    "            val_controlnet_flow = F.interpolate(val_controlnet_flow.flatten(0, 1), (fh, fw), mode='nearest').reshape(fb, fl, 2, fh, fw)\n",
    "            val_controlnet_flow[:, :, 0] *= scales[1]\n",
    "            val_controlnet_flow[:, :, 1] *= scales[0]\n",
    "\n",
    "    \n",
    "        # 1. Resize to match DSI spatial resolution (e.g., 64x64)\n",
    "        dsi_mask_spatial = F.interpolate(val_masks_org, size=(64, 64), mode='nearest')\n",
    "\n",
    "        # 2. If the model expects 256 channels (SAM feature size), \n",
    "        # you can pad or project. A common trick is to repeat classes:\n",
    "        val_masks = F.pad(dsi_mask_spatial, (0, 0, 0, 0, 0, 256 - num_frames)).to(torch.float16).to(device) # Pad 14 to 256\n",
    "        # val_masks = val_masks[0,...].unsqueeze(0)\n",
    "        # print(f\"depths.shape is {depths.device} ,flows.shape = {flows.device}\")\n",
    "\n",
    "\n",
    "\n",
    "        val_controlnet_image = val_pixel_values[:, 0:1, :, :, :].repeat(1, val_pixel_values.shape[1], 1, 1, 1)  # [1,21,3,384,384]\n",
    "\n",
    "        val_controlnet_depth = np.repeat(depth_img, val_pixel_values.shape[1], axis=1)\n",
    "\n",
    "        pil_val_pixel_values = [Image.fromarray((val_pixel_values[0][i].permute(1, 2, 0).cpu().numpy()*255).astype(np.uint8)) for i in range(val_pixel_values.shape[1])]\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "        # # Load generated sim-to-real\n",
    "        # r = Image.open(\"/home/MichalMo/projects/ControlNet-diffusers/records_cadis_1/diff_results/r2/diff_output_0020.png\")\n",
    "\n",
    "        # r = np.asarray(r)\n",
    "\n",
    "        # r = cv2.resize(r, (256,256), interpolation=cv2.INTER_NEAREST).astype(np.uint8)\n",
    "        # print(\"r \", r.shape)\n",
    "\n",
    "        # # r = np.moveaxis(r, -1, 0)\n",
    "        # print(\"r \", r.shape)\n",
    "        # first_frame = Image.fromarray(r)\n",
    "\n",
    "\n",
    "        controlnet_image = val_batch[1].transpose(1,2,0)\n",
    "        first_frame = Image.fromarray((controlnet_image * 255).astype(np.uint8))\n",
    "\n",
    "        mbid = parameters[\"mbid\"]\n",
    "        noise_aug = parameters[\"noise_aug\"]\n",
    "        cs = parameters[\"cs\"]    \n",
    "\n",
    "        pil_val_pixel_values_numpy = np.asarray(pil_val_pixel_values[0])\n",
    "        # (256, 256, 3) uint8 0 237\n",
    "        # print(\"pil_val_pixel_values_numpy \", pil_val_pixel_values_numpy.shape, pil_val_pixel_values_numpy.dtype, np.min(pil_val_pixel_values_numpy), np.max(pil_val_pixel_values_numpy))\n",
    "\n",
    "\n",
    "\n",
    "        print(\"pil_val_pixel_values_numpy \", len(pil_val_pixel_values), pil_val_pixel_values_numpy.shape, pil_val_pixel_values_numpy.dtype)\n",
    "\n",
    "        print(\"val_masks shape \", val_masks.shape, val_masks.dtype, val_masks.device)\n",
    "\n",
    "        print(\"val_controlnet_flow shape \", val_controlnet_flow.shape, val_controlnet_flow.dtype, val_controlnet_flow.device)\n",
    "        print(\"val_depths shape \", val_depths.shape, val_depths.dtype, val_depths.device)\n",
    "\n",
    "        # print(\"inp_noisy_latents shape \", inp_noisy_latents.shape, inp_noisy_latents.dtype, inp_noisy_latents.device)\n",
    "\n",
    "\n",
    "        # print(\"encoder_hidden_states dtype \", encoder_hidden_states.dtype, encoder_hidden_states.device)\n",
    "        # print(\"added_time_ids dtype \", added_time_ids.dtype, added_time_ids.device)\n",
    "\n",
    "\n",
    "        video_frames = pipeline(\n",
    "                                    first_frame, \n",
    "                                    first_frame,\n",
    "                                    val_controlnet_flow,              #  [b,f-1,c-1, W, H]\n",
    "                                    val_depths,             # [b,1,256,256]\n",
    "                                    val_masks,              # [b, 256, 64, 64]\n",
    "                                    height=256,\n",
    "                                    width=256,\n",
    "                                    num_frames=num_frames,\n",
    "                                    decode_chunk_size=8,\n",
    "                                    fps=15,\n",
    "\n",
    "                                    motion_bucket_id=mbid,\n",
    "                                    noise_aug_strength=noise_aug,\n",
    "                                    controlnet_cond_scale = cs,\n",
    "\n",
    "\n",
    "                                    # min_guidance_scale=parameters[\"min_gs\"],  # <-- Add this\n",
    "                                    # max_guidance_scale= parameters[\"max_gs\"]\n",
    "\n",
    "                                ).frames[0] \n",
    "\n",
    "\n",
    "        # ================ construct whole video\n",
    "\n",
    "        for i in range(num_frames):\n",
    "            img = video_frames[i]\n",
    "            video_frames[i] = np.array(img)\n",
    "            \n",
    "        viz_flows = []\n",
    "        for i in range(val_controlnet_flow.shape[1]):\n",
    "            temp_flow = val_controlnet_flow[0][i].permute(1, 2, 0)\n",
    "            viz_flows.append(flow_to_image(temp_flow))\n",
    "        viz_flows = [np.uint8(np.ones_like(viz_flows[-1]) * 255)] + viz_flows\n",
    "        viz_flows = np.stack(viz_flows)  # [t-1, h, w, c]\n",
    "        flow_nps = viz_flows\n",
    "\n",
    "\n",
    "        out_nps = video_frames\n",
    "        gt_nps = (val_pixel_values[0].permute(0, 2, 3, 1).cpu().numpy()*255).astype(np.uint8)\n",
    "        ctrl_nps = (val_controlnet_image[0].permute(0, 2, 3, 1).cpu().numpy()*255).astype(np.uint8)\n",
    "        depth_nps =  (val_controlnet_depth[0]).astype(np.uint8)\n",
    "\n",
    "\n",
    "        masks_nps = grayscale_to_color_mask(val_masks_org[0].numpy(), \"cadis\")\n",
    "\n",
    "\n",
    "        out_nps_overlayed = overlay_segmentation(np.array(out_nps), masks_nps)\n",
    "        gt_nps_overlayed = overlay_segmentation(np.array(gt_nps), masks_nps)\n",
    "\n",
    "\n",
    "\n",
    "        # flow_warp_loss_val = flow_warp_loss(out_nps, val_flows)\n",
    "        # print(flow_warp_loss_val)\n",
    "\n",
    "        # overlay_segmentation(gt_nps, masks_nps)\n",
    "\n",
    "\n",
    "        # ctrl_nps - first frame for controlnet,\n",
    "        # flow_nps - viualization of flows\n",
    "        # depth_nps - depths\n",
    "        # out_nps - output video \n",
    "        # gt_nps - ground truth video\n",
    "        total_nps = np.concatenate([ctrl_nps, flow_nps, depth_nps, masks_nps, out_nps, out_nps_overlayed, gt_nps, gt_nps_overlayed], axis=2)\n",
    "\n",
    "\n",
    "        out_nps_full.append(np.array(out_nps))\n",
    "        gt_nps_full.append(gt_nps)\n",
    "        gt_masks_nps_full.append(val_masks_org[0].numpy())\n",
    "\n",
    "\n",
    "    out_nps_full_array = np.array(out_nps_full)\n",
    "    gt_nps_full_array = np.array(gt_nps_full)\n",
    "    gt_masks_nps_full_array = np.array(gt_masks_nps_full)\n",
    "\n",
    "    return video_frames, val_pixel_values, total_nps, metric_results, val_masks_org, [out_nps_full_array, gt_nps_full_array, gt_masks_nps_full_array, first_frame]\n",
    "\n",
    "\n"
   ]
